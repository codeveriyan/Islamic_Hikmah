# Public URL of this project's deployed FastAPI backend (no trailing slash).
# The Sunnah.com key must never be placed in this file.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Optional web override. Local web development defaults to localhost:8000.
EXPO_PUBLIC_WEB_API_BASE_URL=https://api.example.com

# Deprecated compatibility alias for existing build environments.
EXPO_PUBLIC_HADITH_API_BASE_URL=https://api.example.com

# Development-only UI unlock for testing premium features in Expo Go/dev builds
# and localhost. The app also checks __DEV__, so production bundles ignore it.
EXPO_PUBLIC_DEV_UNLOCK_PREMIUM=false

# Google Maps API key — required for the Halal Finder / Mosque Finder screen.
# Obtain from https://console.cloud.google.com/ with Places API enabled.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Google OAuth Web Client ID — required for Google Sign-In.
# Obtain from Firebase Console → Authentication → Sign-in method → Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID_HERE



# ──────────────────────────────────────────────────────────────────────────────
# STATIC CONTENT CDN (Tafsir chunks, Hadith fallback, etc.)
# ──────────────────────────────────────────────────────────────────────────────
# Public read-only GET URL of your Cloudflare R2 bucket or CDN.
# This MUST be set before building for production.
#
# Setup (free, one-time):
#   1. Create a Cloudflare R2 bucket named "islamic-hikmah-cdn"
#   2. Enable public access on the bucket (R2 → Bucket → Settings → Public Access)
#   3. Set this var to your bucket's public URL, e.g.:
#      https://pub-<hash>.r2.dev
#   4. Place Tafsir sources in content-source/tafsirs and optional Hadith
#      fallbacks in content-source/hadith.
#   5. Run `npm run content:prepare`, then bump content-version.json and run
#      `npm run content:upload`.
#
# IMPORTANT: This is a GET-only URL. Never put R2_ACCESS_KEY_ID or
# R2_SECRET_ACCESS_KEY here — those belong in your local shell environment
# or CI secrets, NOT in any .env file.
EXPO_PUBLIC_CONTENT_CDN_URL=https://YOUR_R2_BUCKET_PUBLIC_URL_HERE
