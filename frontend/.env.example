# Public URL of this project's deployed FastAPI backend (no trailing slash).
# The Sunnah.com key must never be placed in this file.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Deprecated compatibility alias for existing build environments.
EXPO_PUBLIC_HADITH_API_BASE_URL=https://api.example.com

# Development-only UI unlock for testing premium features in Expo Go/dev builds
# and localhost. The app also checks __DEV__, so production bundles ignore it.
EXPO_PUBLIC_DEV_UNLOCK_PREMIUM=false
