# Request a key from https://sunnah.com/developers and keep it on the server.
SUNNAH_API_KEY=replace-with-your-sunnah-com-api-key
# Official docs currently publish v1 routes under https://api.sunnah.com/v1.
SUNNAH_API_BASE_URL=https://api.sunnah.com/v1
# Optional. Defaults to backend/data/sunnah_cache.
SUNNAH_CACHE_DIR=./data/sunnah_cache

# Required for persistent accounts, trials, and payment submissions.
MONGO_URL=mongodb://localhost:27017
DB_NAME=islamic_hikmah

# Firebase ID tokens are the only accepted application credentials.
FIREBASE_PROJECT_ID=islamic-hikmah

# Development-only premium allowlist. Production ignores this value.
APP_ENV=production
DEV_PREMIUM_EMAILS=

# Comma-separated browser origins. Native apps are not governed by CORS.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:19006

# Development-only escape hatch. Never enable this in a deployed environment.
ALLOW_IN_MEMORY_DB=false

# UI-contract development only. Keep false during user testing so synthetic
# feedback can never be mistaken for genuine recitation analysis.
LEARN_QURAN_ALLOW_MOCK_SCORING=false

# Quran-trained Whisper inference. The revision is pinned so an upstream model
# change cannot silently alter scoring. CPU works for local testing; use a GPU
# worker for production latency.
LEARN_QURAN_ASR_ENABLED=false
LEARN_QURAN_ASR_MODEL=tarteel-ai/whisper-base-ar-quran
LEARN_QURAN_ASR_REVISION=5c3c53fdf9272c4f6ee0bee09a1e5a4a615ee25c
LEARN_QURAN_ASR_DEVICE=auto
LEARN_QURAN_ASR_CONCURRENCY=1
# Enable only after the pinned model has been downloaded by warm_quran_asr.py.
LEARN_QURAN_ASR_LOCAL_FILES_ONLY=false
# Load the model during backend startup instead of making the first learner wait.
LEARN_QURAN_ASR_PRELOAD=false

# Recitation identification reuses the Quran ASR service, then searches the
# backend-owned 6,236-ayah corpus. These starting thresholds must be calibrated
# with a labelled real-audio benchmark before public production release.
QURAN_IDENTIFY_MIN_CONFIDENCE=0.65
QURAN_IDENTIFY_MIN_MARGIN=0.04
