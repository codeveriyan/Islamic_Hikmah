# Request a key from https://sunnah.com/developers and keep it on the server.
SUNNAH_API_KEY=replace-with-your-sunnah-com-api-key
# Official docs currently publish v1 routes under https://api.sunnah.com/v1.
SUNNAH_API_BASE_URL=https://api.sunnah.com/v1
# Optional. Defaults to backend/data/sunnah_cache.
SUNNAH_CACHE_DIR=./data/sunnah_cache

# Required for persistent accounts, trials, and payment submissions.
MONGO_URL=mongodb://localhost:27017
DB_NAME=islamic_hikmah

# Firebase ID tokens are the only accepted application credentials.
FIREBASE_PROJECT_ID=islamic-hikmah

# Development-only premium allowlist. Production ignores this value.
APP_ENV=production
DEV_PREMIUM_EMAILS=

# Comma-separated browser origins. Native apps are not governed by CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Development-only escape hatch. Never enable this in a deployed environment.
ALLOW_IN_MEMORY_DB=false
